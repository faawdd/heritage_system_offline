# 本地开发/调试配置示例
# 复制为仓库根目录的 .env（该文件已被 .gitignore 忽略，不会入库）：
#   Windows PowerShell:  Copy-Item .env.example .env
#
# 读取方式：django-environ 在 settings.py 启动时加载
#   优先 CONFIG_DIR/.env，其次 BASE_DIR/.env。
# 注意：Electron 桌面版（desktop_backend.py）会用进程内环境变量覆盖部分取值，
#       本文件主要服务于 `python manage.py runserver` 这类本地调试场景。

# ---- 安全 ----
# 生产必须替换为随机值。留空/不设置时 settings.py 会回退到内置 insecure 默认值，
# 因此本地调试请保持本行注释状态（切勿写成 DJANGO_SECRET_KEY= 空值，
# 那会覆盖默认值并触发 "SECRET_KEY setting must not be empty" 启动失败）。
# 需要自定义时取消注释并填入，生成命令：
#   .venv\Scripts\python.exe -c "import secrets;print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=

# ---- 调试开关 ----
# 离线瓦片与前端产物已不再依赖 DEBUG：桌面/离线模式（HERITAGE_DESKTOP_MODE=1）
# 由 heritage_system/urls.py 中显式的 serve 路由提供静态资源。
# 但如果你用 `manage.py runserver` 直接跑非桌面模式，Django 仍需要 DEBUG=1
# 才会通过 django.conf.urls.static.static() 提供 /static/**（否则瓦片 404）。
# 因此：桌面/打包调试可保持 0；纯 runserver 网页调试需要临时置 1。
# 注意：DEBUG 已不再影响 API 鉴权（见下方 HERITAGE_DEV_ALLOW_LOCAL_BYPASS）。
DJANGO_DEBUG=0

# ---- 本地调试鉴权放行（默认关闭）----
# 置 1 时，IsManagementAdmin 允许来自 127.0.0.1/localhost/::1 的未认证请求通过，
# 便于 Vite 热更新时跳过登录流程。这是显式 opt-in 的开发便利开关，
# 生产与打包版必须保持注释/为 0，否则等同于本机越权。
# HERITAGE_DEV_ALLOW_LOCAL_BYPASS=1

# ---- HTTPS 重定向 ----
# 本地以 http:// 访问，必须置 0，否则会被强制跳转到 https 而无法访问。
DJANGO_FORCE_HTTPS=0

# ---- 桌面（离线）模式 ----
# 置 1 时：STATIC_ROOT 指向 APP_DIR/static，前端产物与离线瓦片就地服务，
# 且缺失 key.bin 时允许回退打开明文库。
HERITAGE_DESKTOP_MODE=0

# ---- 路径覆盖（默认使用仓库内 data/ config/ 等目录，一般无需修改）----
# HERITAGE_APP_DIR=
# HERITAGE_DATA_DIR=
# HERITAGE_CONFIG_DIR=
# HERITAGE_LOG_DIR=
# HERITAGE_UPLOAD_DIR=
# HERITAGE_BACKUP_DIR=
# HERITAGE_DB_FILE=

# ---- 首次建库时超级管理员（admin）的初始密码 ----
# 留空则由 sqlcipher_bootstrap 生成随机密码并打印到日志。
HERITAGE_BOOTSTRAP_ADMIN_PASSWORD=

# ---- 离线环境请关闭外部网络依赖 ----
# DEM 高程按需下载会访问 OpenTopography；离线部署关闭即可避免超时等待。
DEM_DOWNLOAD_PROXY_ENABLED=0

# ---- 天地图 key（离线瓦片已内置，仅在线回退时需要）----
# TDT_TK=
# VITE_TDT_TK=
