{
  "name": "heritage-frontend",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "node electron/dev-runner.cjs",
    "desktop:pack": "npm run build && electron-builder --win portable",
    "desktop:pack:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.4",
    "ol": "^10.2.1",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^32.2.1",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.8"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.2"
  },
  "build": {
    "appId": "com.heritage.offline.desktop",
    "productName": "Heritage Offline Desktop",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../desktop_runtime/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "directories": {
      "output": "dist-electron"
    }
  }
}
