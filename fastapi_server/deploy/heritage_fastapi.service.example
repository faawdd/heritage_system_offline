[Unit]
Description=Heritage FastAPI Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/heritage_system/fastapi_server
Environment=PYTHONUNBUFFERED=1
Environment=DJANGO_SETTINGS_MODULE=heritage_system.settings
Environment=DJANGO_WEB_BASE_URL=https://beichenhome.top:9081
ExecStart=/opt/heritage_system/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
